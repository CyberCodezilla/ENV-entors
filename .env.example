# ---------------------------------------------------------------------------
# HeatFlood Guardian — environment variables
# Copy to .env.local for local development
# ---------------------------------------------------------------------------

# Mapbox — required for routing and map display
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_public_token_here

# Backend API — set to deployed API Gateway URL after SAM deploy
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# SageMaker AI (Day 5 optional — keep false for MVP)
SAGEMAKER_ENABLED=false
SAGEMAKER_ENDPOINT_NAME=

# Lambda internal (set automatically by SAM / Amplify)
MAPBOX_TOKEN=your_mapbox_server_token_here
INCIDENTS_TABLE=heatflood-incidents
HOTSPOTS_TABLE=heatflood-hotspots
AUDIT_TABLE=heatflood-audit
AWS_REGION=ap-south-1

# Service version
SERVICE_VERSION=0.1.0

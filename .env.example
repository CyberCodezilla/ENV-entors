# Copy to apps/web/.env.local
NEXT_PUBLIC_API_BASE_URL=https://YOUR_API_ID.execute-api.ap-south-1.amazonaws.com/prod
NEXT_PUBLIC_MAPBOX_TOKEN=pk.YOUR_MAPBOX_PUBLIC_TOKEN

# Lambda env (set via SSM — do NOT put secrets in .env files)
# /heatflood/mapbox-token → your Mapbox SECRET token (server-side routing)

  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.500.0",
    "@aws-sdk/util-dynamodb": "^3.500.0",
    "@types/aws-lambda": "^8.10.145",
    "@types/node": "^20.11.0",
    "@types/uuid": "^9.0.8",
    "esbuild": "^0.21.5",
    "typescript": "^5.4.0"
  }
